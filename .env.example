# ==============================================================================
# MELOFY PRODUCTION ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Paste these variables into your Portainer Stack "Environment variables" section
# or into a .env file in the root directory before running docker compose.
# ==============================================================================

# --- General & Ports ---
WEB_PORT=3000
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,https://melofy.jene.in
TRUST_PROXY=true
STREAM_TICKET_SECRET=change_me_to_a_secure_random_string_32chars

# --- Firebase Client Config (Required for Next.js Web) ---
# Found in Firebase Console -> Project Settings -> General -> Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK Service Account ---
# Base64-encoded string of your serviceAccountKey.json (Recommended for Portainer)
# Encode in PowerShell: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("serviceAccountKey.json"))
# Encode in Linux/Mac: base64 -w 0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Spotify Developer Credentials ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Upstash Redis ---
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Genius Lyrics API (Optional) ---
GENIUS_LYRICS_API=

# --- NodeLink Audio Engine Config ---
LAVALINK_HOST=nodelink
LAVALINK_PORT=2333
LAVALINK_NAME=melofy
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
